// #mobile-nav is a PC-hidden (mobile-only) drawer. Without an explicit
// display: none default, it stayed in normal flow outside of mq-mobile and
// its links remained reachable by Tab even though nothing was visible.
#mobile-nav
  display: none

@media mq-mobile
  #mobile-nav
    display: block
    position: absolute
    top: 0
    left: 0
    width: mobile-nav-width
    height: 100%
    background: color-mobile-nav-background
    border-right: 1px solid #fff

@media mq-mobile
  .mobile-nav-link
    display: block
    color: color-grey
    text-decoration: none
    padding: 15px 20px
    font-weight: bold
    &:hover
      color: #fff
    &:focus-visible
      outline: 2px solid #fff
      outline-offset: -2px
