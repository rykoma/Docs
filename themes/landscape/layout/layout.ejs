<!DOCTYPE html>
<html>
<%- partial('_partial/head') %>
<body>
  <%
    const skipLinkPathParts = (page.path || '').split('/').filter(Boolean);
    const skipLinkLanguage = page.language_switcher ? page.language : (skipLinkPathParts[0] || page.lang || page.language);
    const skipLinkLabel = skipLinkLanguage === 'en' ? 'Skip to main content' : '本文へ移動';
  %>
  <a class="skip-link" href="#main"><%= skipLinkLabel %></a>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', null, {cache: false}) %>
      <div class="outer">
        <section id="main" tabindex="-1"><%- body %></section>
        <% if (theme.sidebar && theme.sidebar !== 'bottom'){ %>
          <%- partial('_partial/sidebar', null, {cache: false}) %>
        <% } %>
      </div>
      <%- partial('_partial/footer', null, {cache: false}) %>
    </div>
    <%- partial('_partial/mobile-nav', null, {cache: false}) %>
    <%- partial('_partial/after-footer') %>
  </div>
</body>
</html>