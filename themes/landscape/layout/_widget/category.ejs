<% const language = page.lang || page.language; %>
<% const posts = site.posts.toArray().filter(post => !language || post.lang === language); %>
<% if (posts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('categories') %></h3>
    <div class="widget">
      <%- language_categories(posts, {show_count: theme.show_count}) %>
    </div>
  </div>
<% } %>
