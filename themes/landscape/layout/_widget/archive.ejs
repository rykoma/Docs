<% const language = page.lang || page.language; %>
<% const posts = site.posts.toArray().filter(post => !language || post.lang === language); %>
<% if (posts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('archive_a') %></h3>
    <div class="widget">
      <%- language_archives(posts, {show_count: theme.show_count, type: theme.archive_type}) %>
    </div>
  </div>
<% } %>
