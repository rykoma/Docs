<%
  const currentLang = post.lang || page.lang || page.language;
  const sameLanguagePost = (candidate) => !currentLang || candidate.lang === currentLang;
  const adjacentPost = (candidate, direction) => {
    const seen = new Set();

    while (candidate && !seen.has(candidate._id || candidate.path)) {
      seen.add(candidate._id || candidate.path);
      if (sameLanguagePost(candidate)) return candidate;
      candidate = candidate[direction];
    }

    return null;
  };
  const newerPost = adjacentPost(post.prev, 'prev');
  const olderPost = adjacentPost(post.next, 'next');
%>
<% if (newerPost || olderPost){ %>
<nav id="article-nav">
  <% if (newerPost){ %>
    <a href="<%- url_for(newerPost.path) %>" id="article-nav-newer" class="article-nav-link-wrap">
      <strong class="article-nav-caption"><%= __('newer') %></strong>
      <div class="article-nav-title">
        <% if (newerPost.title){ %>
          <%= newerPost.title %>
        <% } else { %>
          (no title)
        <% } %>
      </div>
    </a>
  <% } %>
  <% if (olderPost){ %>
    <a href="<%- url_for(olderPost.path) %>" id="article-nav-older" class="article-nav-link-wrap">
      <strong class="article-nav-caption"><%= __('older') %></strong>
      <div class="article-nav-title">
        <% if (olderPost.title){ %>
          <%= olderPost.title %>
        <% } else { %>
          (no title)
        <% } %>
      </div>
    </a>
  <% } %>
</nav>
<% } %>