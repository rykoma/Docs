<% if (post.categories && post.categories.length){ %>
  <div class="article-category">
    <span class="article-category-label"><%= __('category') %>:</span>
    <% post.categories.each(function(category, index){ %>
      <% if (index > 0) { %><span class="article-category-separator">, </span><% } %>
      <span class="article-category-text"><%= category.name %></span>
    <% }) %>
  </div>
<% } %>