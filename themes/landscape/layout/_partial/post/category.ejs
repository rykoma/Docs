<% if (post.categories && post.categories.length){ %>
  <div class="article-category">
    <% const language = page.lang || page.language || 'ja'; %>
    <% post.categories.each(function(category){ %>
      <a class="article-category-link" href="<%- language_taxonomy_url(language, 'category', category.name) %>"><%= category.name %></a>
    <% }) %>
  </div>
<% } %>