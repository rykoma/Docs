<nav id="mobile-nav">
  <%
    const mobilePathParts = (page.path || '').split('/').filter(Boolean);
    const mobileLanguage = page.language_switcher ? page.language : (mobilePathParts[0] || page.lang || page.language);
    const mobileLanguageSegment = mobileLanguage === 'en' ? 'en' : 'ja';
    const mobileHome = url_for(`${mobileLanguageSegment}/`);
  %>
  <% for (var i in theme.menu){ %>
    <a href="<%- i === 'Home' ? mobileHome : i === 'About' ? url_for(`${mobileLanguageSegment}/about/`) : i === 'Contact' ? url_for(`${mobileLanguageSegment}/contact/`) : i === 'Archives' ? url_for(`${mobileLanguageSegment}/${config.archive_dir}/`) : url_for(theme.menu[i]) %>" class="mobile-nav-link"><%= i %></a>
  <% } %>
</nav>