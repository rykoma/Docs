<article id="<%= post.layout %>-<%= post.slug %>" class="h-entry article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="article-meta">
    <% if (post.layout !== 'page') { %>
      <%- partial('post/date', {class_name: 'article-date', date_format: null, index: true}, {cache: false}) %>
    <% } %>
    <%- partial('post/category') %>
  </div>
  <div class="article-inner">
    <%- partial('post/gallery') %>
    <% if (post.link || post.title){ %>
      <header class="article-header">
        <%- partial('post/title', {class_name: 'p-name article-title', index: index}, {cache: false}) %>
        <% if (!index && post.layout !== 'page' && post.updated.valueOf() !== post.date.valueOf()) { %>
          <p class="article-updated"><span class="fa fa-clock-o" aria-hidden="true"></span><span><%= __('updated') %>: <time class="dt-updated" datetime="<%= date_xml(post.updated) %>" itemprop="dateModified"><%= date(post.updated) %></time></span></p>
        <% } %>
      </header>
    <% } %>
    <div class="e-content article-entry" itemprop="articleBody">
      <% if (index){ %>
        <%
          const content = post.content || '';
          const paragraphs = content.match(/<p\b[^>]*>[\s\S]*?<\/p>/gi) || [];
          const preview = post.excerpt || paragraphs.slice(0, 2).join('');
          const hasMore = post.excerpt
            ? post.excerpt.trim() !== content.trim()
            : !paragraphs.length || paragraphs.length > 2 ||
              content.trim().replace(/\s+/g, '') !== preview.trim().replace(/\s+/g, '');
        %>
        <% if (preview) { %>
          <%- preview %>
        <% } else { %>
          <p><%= post.description %></p>
        <% } %>
        <% if (hasMore) { %>
          <p class="article-more-link">
            <a href="<%- url_for(post.path) %>"><%= (page.lang || page.language) === 'ja' ? '続きを読む' : 'Read more' %></a>
          </p>
        <% } %>
      <% } else { %>
        <%- post.content %>
      <% } %>
    </div>
    <footer class="article-footer">
      <%- partial('post/tag') %>
      <% if (!index) { %>
      <% const sourceUrl = github_source_url(post); %>
      <span class="article-action-links">
      <% if (sourceUrl) { %>
      <a href="<%- sourceUrl %>" class="article-source-link" target="_blank" rel="noopener noreferrer"><%= (post.lang || post.language || config.language) === 'ja' ? 'ソース' : 'Source' %></a>
      <% } %>
      <a href="#" data-url="<%- post.permalink %>" data-id="<%= post._id %>" data-title="<%= post.title %>" class="article-share-link" role="button" aria-expanded="false"><span class="fa fa-share" aria-hidden="true"></span><span class="article-share-text"><%= __('share') %></span></a>
      </span>
      <% } %>
      <% if (post.comments && theme.disqus_shortname){ %>
        <a href="<%- post.permalink %>#disqus_thread" class="article-comment-link"><span class="fa fa-comment"><%= __('comment') %></span></a>
      <% } %>
      <% if (post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey ){ %>
        <a href="<%- url_for(post.path) %>#comments" class="article-comment-link">
          <span class="post-comments-count valine-comment-count fa fa-comment" data-xid="<%- url_for(post.path) %>" itemprop="commentCount"></span>
          <%= __('comment') %>
        </a>
      <% } %>
    </footer>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments && theme.disqus_shortname){ %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
<% if (!index && post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey){ %>
  <section id="comments" class="vcomment">

  </section>
<% } %>