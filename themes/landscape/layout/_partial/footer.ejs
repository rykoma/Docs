<footer id="footer">
  <% if (theme.sidebar === 'bottom'){ %>
    <%- partial('_partial/sidebar') %>
  <% } %>
  <div class="outer">
    <div id="footer-info" class="inner">
      <% if (theme.copyright){ %>
        <%- render(theme.copyright, 'pug'); %>
      <% } %>
      &copy; <%= date(new Date(), 'YYYY') %>
      <a href="https://github.com/rykoma" target="_blank" rel="noopener noreferrer"><%= config.author || site_title(page.lang || page.language) %></a>
    </div>
  </div>
</footer>
