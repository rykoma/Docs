<header id="header">
  <%
    const pathParts = (page.path || '').split('/').filter(Boolean);
    const languageHome = page.language_switcher;
    const currentLanguage = languageHome ? page.language : (pathParts[0] || page.lang || page.language);
    const currentLanguageHome = url_for(`${currentLanguage === 'en' ? 'en' : 'ja'}/`);
  %>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <h1 id="logo-wrap">
        <a href="<%- currentLanguageHome %>" id="logo"><%= site_title(currentLanguage) %></a>
      </h1>
      <% if (theme.subtitle || config.subtitle){ %>
        <h2 id="subtitle-wrap">
          <a href="<%- currentLanguageHome %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
        </h2>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% for (var i in theme.menu){ %>
          <a class="main-nav-link" href="<%- i === 'Home' ? currentLanguageHome : i === 'About' ? url_for(`${currentLanguage}/about/`) : i === 'Archives' ? url_for(`${currentLanguage}/${config.archive_dir}/`) : url_for(theme.menu[i]) %>"><%= i %></a>
        <% } %>
      </nav>
      <nav id="sub-nav">
        <% if (theme.language_switcher && theme.language_switcher.enable && (page.lang || page.language)) { %>
          <%
            const isIndex = Boolean(languageHome);
            const currentSlug = !isIndex && pathParts[1] && pathParts[1] !== 'page' && pathParts[1] !== 'index.html'
              ? pathParts[1]
              : null;
            const taxonomyType = page.category ? 'categories' : page.tag ? 'tags' : (pathParts[0] === 'categories' || pathParts[0] === 'tags' ? pathParts[0] : (pathParts[1] === 'categories' || pathParts[1] === 'tags' ? pathParts[1] : null));
            const taxonomyName = page.category || page.tag || (taxonomyType === pathParts[0] ? pathParts[1] : (taxonomyType && pathParts[2] ? pathParts.slice(2).join('/') : null));
            const localizedContent = site.posts.toArray().concat(site.pages.toArray());
            const currentContent = currentSlug && localizedContent.find(content =>
              content.lang === currentLanguage && content.slug.split('/').pop() === currentSlug
            );
            const languageUrls = languageHome || {
              ja: taxonomyName ? url_for(`ja/${taxonomyType}/${encodeURIComponent(taxonomyName)}/`) : url_for(localizedContent.find(content =>
                content.lang === 'ja' && content.slug.split('/').pop() === currentSlug
              )?.path || 'ja/'),
              en: taxonomyName ? url_for(`en/${taxonomyType}/${encodeURIComponent(taxonomyName)}/`) : url_for(localizedContent.find(content =>
                content.lang === 'en' && content.slug.split('/').pop() === currentSlug
              )?.path || 'en/')
            };
          %>
          <div class="language-switcher">
            <button type="button" class="language-switcher-button" aria-haspopup="true" aria-expanded="false" aria-controls="language-switcher-menu">
              <span class="language-switcher-current"><%= theme.language_switcher[currentLanguage] %></span>
              <span class="language-switcher-arrow" aria-hidden="true"></span>
            </button>
            <ul id="language-switcher-menu" class="language-switcher-menu" role="menu" hidden aria-label="<%= theme.language_switcher.label %>">
            <% for (const language of ['ja', 'en']) { %>
              <li role="none">
                <a role="menuitem" href="<%- languageUrls[language] %>"<%- currentLanguage === language ? ' aria-current="page"' : '' %><%- currentContent && !localizedContent.some(content => content.lang === language && content.slug.split('/').pop() === currentSlug) ? ' aria-disabled="true" tabindex="-1"' : '' %>><%= theme.language_switcher[language] %><%= currentLanguage === language ? ` (${currentLanguage === 'ja' ? '現在' : 'current'})` : '' %></a>
              </li>
            <% } %>
            </ul>
          </div>
        <% } %>
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" href="<%- url_for(theme.links[i]) %>"><span class="fa fa-<%= i %>"></span></a>
          <% } %>
        <% } %>
        <% if (theme.rss){ %>
          <a class="nav-icon" href="<%- url_for(`${currentLanguage === 'en' ? 'en' : 'ja'}/rss.xml`) %>" title="<%= __('rss_feed') %>"><span class="fa fa-rss"></span></a>
        <% } %>
        <a class="nav-icon nav-search-btn" title="<%= __('search') %>"><span class="fa fa-search"></span></a>
      </nav>
      <div id="search-form-wrap">
        <%- search_form({button: '&#xF002;', text: __('search')}) %>
      </div>
    </div>
  </div>
</header>
