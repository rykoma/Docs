<%
const adsense = theme.adsense;
if (adsense) {
  const publisherId = adsense.publisher_id;
  const site = new URL(config.url);
  if (typeof publisherId !== 'string' || !/^ca-pub-\d+$/.test(publisherId)) {
    throw new Error(`Invalid Google AdSense publisher ID: ${publisherId}`);
  }
  if (site.origin === 'https://blog.rykoma.net') {
    if (typeof slot !== 'string' || !/^\d+$/.test(slot)) {
      throw new Error(`Invalid Google AdSense ad slot: ${slot}`);
    }
    const label = language === 'en' ? 'Advertisement' : '広告';
%>
<div class="adsense-ad <%= className %>">
  <p class="adsense-ad-label"><%= label %></p>
  <ins class="adsbygoogle"
    style="display:block"
    data-ad-client="<%= publisherId %>"
    data-ad-slot="<%= slot %>"
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script>
    if (window.location.hostname === 'blog.rykoma.net') {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } else {
      document.currentScript.parentElement.remove();
    }
  </script>
</div>
<%
  }
}
%>
